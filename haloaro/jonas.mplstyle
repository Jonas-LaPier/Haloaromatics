# plot-like-jonas: white background, Cambria, black, boxed axes, outward ticks, no grid, unframed legend.
# jonas_plot.use_style() loads this and swaps in Caladea if Cambria isn't installed.
font.family: serif
font.serif: Cambria, Caladea, Times New Roman, DejaVu Serif
font.size: 10
axes.labelsize: 10
axes.titlesize: 10
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 9
legend.frameon: False
legend.handletextpad: 0.3
legend.borderaxespad: 0.8
text.color: black
axes.labelcolor: black
axes.edgecolor: black
axes.linewidth: 1.0
axes.grid: False
axes.spines.top: True
axes.spines.right: True
axes.prop_cycle: cycler('color', ['000000', 'a6a6a6', '555555'])
xtick.direction: out
ytick.direction: out
xtick.top: False
ytick.right: False
xtick.major.size: 4
ytick.major.size: 4
xtick.major.width: 1.0
ytick.major.width: 1.0
xtick.minor.visible: False
ytick.minor.visible: False
xtick.color: black
ytick.color: black
lines.linewidth: 1.5
lines.markersize: 7
lines.markeredgewidth: 0.8
errorbar.capsize: 4
figure.figsize: 3.5, 3.0
figure.dpi: 150
savefig.dpi: 600
savefig.bbox: tight
savefig.transparent: False
savefig.facecolor: white
figure.facecolor: white
axes.facecolor: white
